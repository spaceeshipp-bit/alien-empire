{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alien-empire-td.invalid/stages.schema.json",
  "title": "PvE stages",
  "description": "Story stages: a portrait map with its lanes and build tiles, the waves, and the stage's lives, credits and towers. sim/core/stage.gd and tools/stages.py turn a stage and a seed into a battle spec, growing wave HP and kill credits per wave as the build prompt says. Units follow common.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stages"],
  "properties": {
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        { "$ref": "common.schema.json#/$defs/mt" },
        { "$ref": "common.schema.json#/$defs/mt" }
      ],
      "items": false,
      "minItems": 2
    },
    "tile": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 63 },
        { "type": "integer", "minimum": 0, "maximum": 63 }
      ],
      "items": false,
      "minItems": 2,
      "description": "[column, row]. Its center is at (column * 1000 + 500, row * 1000 + 500) mt."
    },
    "path": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/point" }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ground"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "ground": { "$ref": "#/$defs/path", "description": "From the top edge of the map to the Core." },
        "air": {
          "$ref": "#/$defs/path",
          "description": "The air route, which the config tool keeps 35% to 45% shorter than the ground lane (the build prompt's 40%)."
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enemy", "lane", "count", "offset_ms", "interval_ms"],
      "properties": {
        "enemy": { "$ref": "common.schema.json#/$defs/id" },
        "lane": { "$ref": "common.schema.json#/$defs/id" },
        "count": { "type": "integer", "minimum": 1, "maximum": 500 },
        "offset_ms": { "$ref": "common.schema.json#/$defs/ms", "description": "First spawn, from the wave's start." },
        "interval_ms": { "$ref": "common.schema.json#/$defs/ms", "description": "Time between spawns in the group." }
      }
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "groups"],
      "properties": {
        "start_ms": { "$ref": "common.schema.json#/$defs/ms", "description": "From the battle's start. Waves come on a timer." },
        "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/group" } }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tower", "tile"],
      "properties": {
        "tower": { "$ref": "common.schema.json#/$defs/id" },
        "tile": { "$ref": "#/$defs/tile" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "width", "height", "core", "lanes", "build_tiles", "lives", "credits", "towers",
        "hp_growth_bp", "credit_growth_bp", "call_credits_per_s", "call_credits_max", "clean_wave_credits",
        "max_ms", "waves", "reference_layout"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "width": { "type": "integer", "minimum": 3, "maximum": 64, "description": "Map width in tiles." },
        "height": { "type": "integer", "minimum": 3, "maximum": 64, "description": "Map height in tiles." },
        "core": { "$ref": "#/$defs/tile", "description": "The tile the Core stands on, at the bottom of the map." },
        "lanes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lane" } },
        "build_tiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tile" },
          "description": "Where field towers may stand: never on a lane or the Core."
        },
        "lives": { "type": "integer", "minimum": 1, "maximum": 1000, "description": "Lives at the start (Q2: 20)." },
        "credits": {
          "type": "integer",
          "minimum": 0,
          "description": "Battle credits at the start. The wave pressure tool checks them against the build prompt's targets."
        },
        "towers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" },
          "description": "Tower ids the player may build here."
        },
        "hp_growth_bp": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 100000,
          "description": "Wave HP grows by this factor per wave: the build prompt's x1.09 is 10900."
        },
        "credit_growth_bp": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 100000,
          "description": "Kill credits grow by this factor per wave: the build prompt's x1.03 is 10300."
        },
        "call_credits_per_s": { "type": "integer", "minimum": 0, "description": "Credits a second skipped when the player calls the next wave early (D-036)." },
        "call_credits_max": { "type": "integer", "minimum": 0, "description": "The most one early call pays." },
        "clean_wave_credits": { "type": "integer", "minimum": 0, "description": "Paid for a wave that dies with no leak (D-036)." },
        "max_ms": { "$ref": "common.schema.json#/$defs/ms", "minimum": 50, "description": "A hard stop well after the last wave." },
        "waves": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/wave" } },
        "reference_layout": {
          "type": "array",
          "items": { "$ref": "#/$defs/placement" },
          "description": "A fixed set of towers for the wave pressure tool: its kill zone, and the playthrough check (M1-F)."
        }
      }
    }
  }
}
