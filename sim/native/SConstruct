#!/usr/bin/env python
# Builds the sim core GDExtension into sim/bin/. Run through tools/build_sim_native.sh,
# which fetches the pinned godot-cpp and picks the platforms.
import os

godot_cpp = os.environ.get("GODOT_CPP_DIR")
if not godot_cpp:
    raise SystemExit("Set GODOT_CPP_DIR to a godot-cpp checkout (tools/build_sim_native.sh does).")

env = SConscript(os.path.join(godot_cpp, "SConstruct"), {"api_version": "4.7"})

env.Append(CPPPATH=["src/"])
if not env.get("is_msvc", False):
    # Defined wrap-around for signed overflow, as GDScript's int has; the sim
    # stays far from the limits, so this only removes undefined behaviour.
    env.Append(CCFLAGS=["-fwrapv"])

sources = Glob("src/core/*.cpp") + Glob("src/godot/*.cpp")
library = env.SharedLibrary("../bin/libaetd_sim{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)
env.NoCache(library)
Default(library)
