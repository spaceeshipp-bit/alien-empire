# Godot editor cache (import settings in *.import files ARE committed)
.godot/

# Copies of /sim made by tools/sync_sim.py at build time
/client/sim/
/worker/sim/

# Sim core libraries built from sim/native by tools/build_sim_native.sh, and
# SCons's object files and state
/sim/bin/
/sim/native/**/*.os
/sim/native/**/*.o
/sim/native/.sconsign*.dblite

# Android build template installed by Godot, plus build outputs
/client/android/
/build/
*.apk
*.aab
*.idsig

# Third-party Godot plugins are fetched, not committed (see docs/PLUGINS.md)
/client/addons/GodotGooglePlayBilling/
/client/addons/admob/
/client/addons/GodotPlayGameServices/
/client/addons/godotx_firebase/
/client/addons/PlayIntegrity/bin/

# Which build this is: written by tools/ci/prepare_android_export.sh before export
/client/build_info.json

# Owner-specific Google files and signing keys never go in the repo
google-services.json
*.keystore
*.jks
ANDROID_KEYSTORE_*.txt
ANDROID_KEY_ALIAS.txt

# Gradle and Python caches
.gradle/
/client/android_plugins/**/build/
__pycache__/
.pytest_cache/
*.pyc
/tools/reference/build/

# OS clutter
.DS_Store
Thumbs.db
