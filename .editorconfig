root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,cfg,tscn,tres,godot}]
indent_style = tab
indent_size = 4

[*.{py,java,c}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,gradle,kts}]
indent_style = space
indent_size = 2
